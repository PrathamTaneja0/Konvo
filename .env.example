# Copy to .env (git-ignored) and fill in your own values. Never commit .env.
# docker compose reads it, and the backend imports it when started with mvn spring-boot:run.

# MariaDB root password (any value for local development)
KONVO_DB_PASSWORD=change-me

# JWT signing key: a random string of at least 32 characters
# Generate one with: openssl rand -hex 32
KONVO_JWT_SECRET=

# NewsAPI key from https://newsapi.org/register (leave empty to disable the news feed)
KONVO_NEWS_API_KEY=
